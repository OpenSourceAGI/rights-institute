# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
#
# GOOGLE_CLIENT_ID alone powers both the server OAuth flow and the Google
# One Tap prompt. It is read at request time — so it works whether it's set
# in .env, as a Cloudflare Worker runtime var, or as a `wrangler secret` —
# and reaches the browser via /api/client-config. No NEXT_PUBLIC_ copy is
# needed; set NEXT_PUBLIC_GOOGLE_CLIENT_ID only if you'd rather inline it at
# build time.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Better Auth Configuration
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-secret-key-here

# App URL - set for local dev. In production you can leave both unset:
# better-auth then takes the origin from each request, which is correct for a
# Cloudflare Worker answering on rights.institute, www., and preview URLs.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
#
# On Cloudflare the database comes from the `DB` D1 binding in wrangler.jsonc —
# a binding ships with the deployment, so nothing below is needed in
# production. Apply migrations with: wrangler d1 migrations apply DB --remote
#
# Outside Workers (local dev, tests) the app falls back to libSQL/Turso. The
# web client speaks libsql:/https:/wss: only — there is no local-file option.
TURSO_DATABASE_URL=your-turso-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# Resend (magic-link email sender) - https://resend.com/api-keys
AUTH_RESEND_KEY=re_your_resend_api_key

# OAuth Callback URLs (add these to your Google OAuth credentials):
# Local: http://localhost:3000/api/auth/callback/google
# Production: https://rights.institute/api/auth/callback/google
