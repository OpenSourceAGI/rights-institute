# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
#
# GOOGLE_CLIENT_ID alone powers both the server OAuth flow and the Google
# One Tap prompt — the root layout reads it at request time (so it works
# whether it's set in .env, a Cloudflare Worker runtime var, or a
# `wrangler secret`) and hands it to the browser. No separate
# NEXT_PUBLIC_ copy is needed.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Better Auth Configuration
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-secret-key-here

# App URL - Use http://localhost:3000 for Next.js dev, or your deployed URL
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database - Turso (libSQL) Configuration
TURSO_DATABASE_URL=your-turso-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# Resend (magic-link email sender) - https://resend.com/api-keys
AUTH_RESEND_KEY=re_your_resend_api_key

# OAuth Callback URLs (add these to your Google OAuth credentials):
# Local: http://localhost:3000/api/auth/callback/google
# Production: https://rights.institute/api/auth/callback/google
