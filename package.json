{
  "name": "rights-institute",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "homepage": "https://rights.institute",
  "description": "10 Understandings, 10 Rights, 10 Problems of Conscious Life",
  "license": "rights.institute/prosper",
  "author": "vtempest",
  "repository": {
    "type": "git",
    "url": "https://github.com/opensourceagi/rights-institute"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "preview": "turbo run preview",
    "deploy": "turbo run deploy",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter rights-web db:generate",
    "db:push": "pnpm --filter rights-web db:push",
    "db:studio": "pnpm --filter rights-web db:studio"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  },
  "type": "module"
}
